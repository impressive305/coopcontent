DATABASE_URL="postgresql://coop:coop@localhost:5432/coopconnect"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Optional: AI-personalized training plans. Without a key, plans come from the built-in engine.
ANTHROPIC_API_KEY=""
# PLAN_AI_MODEL="claude-opus-5-5"
# PLAN_AI_EFFORT="medium"   # low | medium | high
# PLAN_AI="off"             # force engine-only plans

# Session cookie (httpOnly). Secure defaults on in production.
# COOKIE_SAMESITE="lax"     # use "none" only if the frontend and API are on different sites (forces Secure)
# COOKIE_SECURE="true"

# The supervisor role is disabled for now; set to "true" here and
# NEXT_PUBLIC_SUPERVISOR_ROLE_ENABLED=true in frontend/.env.local to bring it back.
# SUPERVISOR_ROLE_ENABLED="true"
