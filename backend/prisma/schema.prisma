generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  SUPERVISOR
  COMPANY
  ADMIN
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PlacementStatus {
  ACTIVE
  COMPLETED
}

enum ReportType {
  WEEKLY
  FINAL
}

enum PlanSource {
  ENGINE
  AI
  MANUAL
}

// A company's sign-up request: the training unit contacts the company outside
// the platform, completes its details, then approves or rejects it.
enum CompanyReview {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
}

enum ReportStatus {
  SUBMITTED
  APPROVED
  RETURNED
}

// Support tickets that users open with the system administrators.
enum TicketCategory {
  TECHNICAL
  GUIDANCE
  OTHER
}

// OPEN: waiting on an administrator. ANSWERED: waiting on the user. CLOSED: done.
enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  // Suspended accounts cannot sign in or use existing tokens.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  student         Student?
  company         Company?
  supervisedUnits Placement[]   @relation("SupervisorPlacements")
  companyNotes    CompanyNote[]
  tickets         Ticket[]
  ticketMessages  TicketMessage[]

  @@map("users")
}

model Student {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  universityId String   @unique @map("university_id")
  university   String
  major        String
  gpa          Decimal? @db.Decimal(3, 2)
  // 4 or 5: Saudi universities grade on either scale.
  gpaScale     Int?     @map("gpa_scale")
  skills       String[] @default([])
  cvUrl        String?  @map("cv_url")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  placements   Placement[]
  plans        TrainingPlan[]

  @@map("students")
}

// A training organization. Companies that register have a user account; the
// admin can also add directory-only companies (no account, no CR number).
model Company {
  id           Int           @id @default(autoincrement())
  userId       Int?          @unique @map("user_id")
  name         String
  crNumber     String?       @unique @map("cr_number")
  city         String
  sector       String
  // true only once the request is APPROVED; set together with reviewStatus.
  verified     Boolean       @default(false)
  reviewStatus CompanyReview @default(PENDING) @map("review_status")
  reviewedAt   DateTime?     @map("reviewed_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  // Directory profile shown to students, who apply directly to the company.
  description  String?
  website      String?
  contactEmail String?       @map("contact_email")
  phone        String?
  address      String?
  majors       String[]      @default([])
  coopOpen     Boolean       @default(true) @map("coop_open")

  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logo          CompanyLogo?
  notes         CompanyNote[]
  opportunities Opportunity[]
  placements    Placement[]

  @@map("companies")
}

// The training unit's internal log of contact with a company. Never shown to the company.
model CompanyNote {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  authorId  Int?     @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("company_notes")
}

// Kept apart from Company so logo bytes never ride along in company queries.
model CompanyLogo {
  companyId Int      @id @map("company_id")
  data      Bytes
  mimeType  String   @map("mime_type")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_logos")
}

model Opportunity {
  id            Int      @id @default(autoincrement())
  companyId     Int      @map("company_id")
  title         String
  description   String
  major         String
  city          String
  seats         Int
  durationWeeks Int      @map("duration_weeks")
  deadline      DateTime
  isOpen        Boolean  @default(true) @map("is_open")
  createdAt     DateTime @default(now()) @map("created_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([major, city])
  @@map("opportunities")
}

model Application {
  id            Int               @id @default(autoincrement())
  studentId     Int               @map("student_id")
  opportunityId Int               @map("opportunity_id")
  coverLetter   String?           @map("cover_letter")
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now()) @map("created_at")
  decidedAt     DateTime?         @map("decided_at")

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  placement   Placement?

  @@unique([studentId, opportunityId])
  @@map("applications")
}

// Created when a company accepts an in-platform application, or recorded by the
// admin for a student who applied to the company directly (no application).
model Placement {
  id            Int             @id @default(autoincrement())
  applicationId Int?            @unique @map("application_id")
  title         String?
  studentId     Int             @map("student_id")
  companyId     Int             @map("company_id")
  supervisorId  Int?            @map("supervisor_id")
  startDate     DateTime        @map("start_date")
  endDate       DateTime        @map("end_date")
  status        PlacementStatus @default(ACTIVE)

  application Application?   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plans       TrainingPlan[]
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supervisor  User?          @relation("SupervisorPlacements", fields: [supervisorId], references: [id])
  reports     Report[]

  @@map("placements")
}

model Report {
  id          Int          @id @default(autoincrement())
  placementId Int          @map("placement_id")
  type        ReportType
  weekNo      Int?         @map("week_no")
  tasks       String
  hours       Int
  skills      String
  challenges  String?
  status      ReportStatus @default(SUBMITTED)
  feedback    String?
  submittedAt DateTime     @default(now()) @map("submitted_at")
  reviewedAt  DateTime?    @map("reviewed_at")

  placement Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@unique([placementId, type, weekNo])
  @@map("reports")
}

model Ticket {
  id        Int            @id @default(autoincrement())
  authorId  Int            @map("author_id")
  subject   String
  category  TicketCategory
  status    TicketStatus   @default(OPEN)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  closedAt  DateTime?      @map("closed_at")

  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([authorId])
  @@index([status])
  @@map("tickets")
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  authorId  Int?     @map("author_id")
  // Recorded when written, so a later role change never rewrites who answered.
  fromStaff Boolean  @map("from_staff")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("ticket_messages")
}

model TrainingPlan {
  id            Int        @id @default(autoincrement())
  studentId     Int        @map("student_id")
  placementId   Int?       @map("placement_id")
  // The student's major and chosen field in their own words. majorKey/trackKey
  // are set only when the field matched a catalog track.
  major         String?
  focus         String?
  sector        String?
  majorKey      String?    @map("major_key")
  trackKey      String?    @map("track_key")
  durationWeeks Int        @map("duration_weeks")
  hoursPerWeek  Int        @map("hours_per_week")
  startDate     DateTime?  @map("start_date")
  source        PlanSource
  model         String?
  // Plan body (see src/lib/plans/schema.js); task completion lives inside it.
  content       Json
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  placement Placement? @relation(fields: [placementId], references: [id], onDelete: SetNull)

  @@index([studentId, isActive])
  @@map("training_plans")
}
