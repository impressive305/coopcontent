# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the browser bundle,
# so never put a secret here.

# Where the browser reaches the API (default: http://localhost:4000/api).
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# The supervisor role is disabled for now; set to "true" here and
# SUPERVISOR_ROLE_ENABLED=true in backend/.env to bring it back.
# NEXT_PUBLIC_SUPERVISOR_ROLE_ENABLED="true"
